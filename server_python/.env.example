# Configurações do Servidor Python com LlamaIndex

# Porta do servidor
PORT=5001

# Provedor de LLM: "openai" ou "ollama"
LLM_PROVIDER=openai

# Chave da API OpenAI (necessária se LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-sua-chave-aqui

# Engine de OCR: "ollama-ocr", "paddleocr" ou "tesseract"
OCR_ENGINE=ollama-ocr

# Configuração opcional do ollama-ocr
OLLAMA_OCR_MODEL=llama3.2-vision:11b
OLLAMA_BASE_URL=http://localhost:11434/api/generate
OLLAMA_OCR_LANGUAGE=pt
